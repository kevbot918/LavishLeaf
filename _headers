# Test builds for friends, linked quietly from /symphonymph. Kept out of
# search results, and served as Android packages so a phone offers to install.
/downloads/*
  X-Robots-Tag: noindex, nofollow
  Content-Type: application/vnd.android.package-archive
  Content-Disposition: attachment

# Read by every copy of the app once a day (lib/core/withdrawn_list.dart), so
# a short cache: a withdrawal should reach phones the same day.
/withdrawn.json
  Cache-Control: public, max-age=3600
  Content-Type: application/json; charset=utf-8

# Android reads this to let Symphonymph open lavishleaf.org/p links (shared
# playlists) itself instead of the browser. Must be JSON, and never redirected.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: public, max-age=3600

# A shared playlist lives after the # in its link; this page reads it in the
# browser. No referrer leaves it, and it is not for search engines.
/p
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex
/p.html
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex

# The shipping rules, imported by the cart in the browser as an ES module
# (and by the checkout functions on the server). A module must be served as
# JavaScript or the browser refuses it.
/shipping.mjs
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=300

# The sales-tax rules, the same way (tax.mjs, 2026-10-07).
/tax.mjs
  Content-Type: text/javascript; charset=utf-8
  Cache-Control: public, max-age=300

# The owner's dashboard, its sample data and the email templates (shown to
# subscribers through "View in your browser") are not for search engines.
/dashboard.html
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/dashboard
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
/emails/*
  X-Robots-Tag: noindex
/tools/*
  X-Robots-Tag: noindex
